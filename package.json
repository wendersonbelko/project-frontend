{
  "name": "tk-customer-protal",
  "private": true,
  "version": "0.0.3",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --mode development --port 4000",
    "build": "npx --max_old_space_size=4096 vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write . && yarn lint",
    "analyze": "yarn run format && yarn test --silent && yarn build",
    "preview": "vite preview",
    "test:open-e2e": "cypress open --e2e --browser chrome",
    "test:open-unit": "cypress open --component --browser chrome",
    "test:run-e2e": "cypress run --e2e",
    "test:run-unit": "cypress run --component",
    "test:e2e": "start-server-and-test start http-get://localhost:3000 cy:open-e2e",
    "test": "jest --passWithNoTests",
    "test:ci": "NODE_ENV=test yarn test --coverage --noStackTrace --silent",
    "sonar": "rm -rf coverage && yarn test:ci && sonar-scanner",
    "dc:dev": "docker-compose -f docker-compose.yml up --build --force-recreate --remove-orphans && docker-compose -f docker-compose.yml down --volumes --remove-orphans",
    "dc:staging": "docker build  --build-arg MODE=staging",
    "dc:production": "docker build  --build-arg MODE=production",
    "update-version": "node -e \"const fs = require('fs'); fs.writeFileSync('VERSION', process.env.npm_package_version)\"",
    "release": "standard-version",
    "release-beta": "yarn release --prerelease beta && yarn update-version",
    "release-major": "yarn release -- --release-as major && yarn update-version"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@microsoft/applicationinsights-react-js": "^3.4.3",
    "@microsoft/applicationinsights-web": "^3.0.2",
    "@types/moment": "^2.13.0",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "^5.5.2",
    "axios": "^1.4.0",
    "cpf-cnpj-validator": "^1.0.3",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.10",
    "inversify": "^6.0.1",
    "query-string": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^6.11.2",
    "react-text-mask": "^5.5.0",
    "remove": "^0.1.5",
    "tsconfig-paths": "^4.2.0",
    "typeface-poppins": "^1.1.13",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/preset-env": "^7.22.4",
    "@babel/preset-react": "^7.22.3",
    "@chromatic-com/storybook": "^1.5.0",
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@faker-js/faker": "^8.0.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.2",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@types/react-input-mask": "^3.0.4",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-text-mask": "^5.4.13",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "axios-mock-adapter": "^1.21.4",
    "babel-jest": "^29.5.0",
    "cypress": "^4.2.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^13.2.3",
    "prettier": "^2.8.8",
    "reflect-metadata": "^0.1.13",
    "sonar-scanner": "3.1.0",
    "standard-version": "9.5.0",
    "storybook": "^8.1.6",
    "terser": "^5.19.2",
    "typescript": "^5.0.4",
    "vite": "^4.3.9"
  }
}
